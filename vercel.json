{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.saragillard.com"
        }
      ],
      "destination": "https://saragillard.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/lab/:projectSlug",
      "destination": "/lab/:projectSlug/index.html"
    },
    {
      "source": "/lab/:projectSlug/",
      "destination": "/lab/:projectSlug/index.html"
    },
    {
      "source": "/tucked-away",
      "destination": "/tucked-away.html"
    },
    {
      "source": "/tucked-away/",
      "destination": "/tucked-away.html"
    }
  ]
}
